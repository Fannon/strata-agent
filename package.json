{
  "name": "strata-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed capability composition for Pi, hosted by Bun",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fannon/strata-agent.git"
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit",
    "demo": "bun examples/demo.ts",
    "generate": "bun examples/generate.ts",
    "pi": "bun node_modules/@mariozechner/pi-coding-agent/dist/cli.js --no-extensions -e ./src/pi/extension.ts",
    "test:agent": "bun examples/agent-smoke.ts"
  },
  "pi": {
    "extensions": [
      "./src/pi/extension.ts"
    ]
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "quickjs-emscripten": "0.32.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.1"
  }
}
